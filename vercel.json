{
  "buildCommand": "npx sourcey build && node scripts/inject-qa.js && node scripts/verify-qa-injection.mjs",
  "outputDirectory": "dist",
  "installCommand": "npm install",
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/",
      "destination": "/introduction",
      "permanent": false
    },
    {
      "source": "/api-reference",
      "destination": "/api",
      "permanent": true
    }
  ]
}
